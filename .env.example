# Copy to .env.local. Both are optional and read only by the local Vite server;
# they never reach the browser.

# Lichess opening explorer ("people at your level" in Openings, punish decks).
# A free personal token with no scopes: https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Optional LLM narration for the move-by-move coach.
ANTHROPIC_API_KEY=
